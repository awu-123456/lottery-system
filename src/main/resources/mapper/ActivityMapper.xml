<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lotterysystem.dao.mapper.ActivityMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into activity (activity_name, description, status)
        values (#{activityName}, #{description}, #{status})
    </insert>

    <update id="updateStatus">
        update activity set status = #{status} where id = #{id}
    </update>

    <select id="count" resultType="int">
        select count(1) from activity
    </select>

    <select id="selectActivityList" resultType="com.example.lotterysystem.dao.dataobject.ActivityDO">
        select * from activity order by id desc limit #{offset}, #{pageSize}
    </select>

    <select id="selectById" resultType="com.example.lotterysystem.dao.dataobject.ActivityDO">
        select * from activity where id = #{id}
    </select>
</mapper>