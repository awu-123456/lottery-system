<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lotterysystem.dao.mapper.PrizeMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into prize (name, image_url, price, description)
        values (#{name}, #{imageUrl}, #{price}, #{description})
    </insert>

    <select id="count" resultType="java.lang.Integer">
        select count(1) from prize
    </select>

    <select id="selectPrizeList" resultType="com.example.lotterysystem.dao.dataobject.PrizeDO">
        select * from prize order by id desc limit #{offset}, #{pageSize}
    </select>

    <select id="selectExistById" resultType="java.lang.Long">
        select id from prize
        where id in
        <foreach item="item" collection="items" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="batchSelectByIds" resultType="com.example.lotterysystem.dao.dataobject.PrizeDO">
        select * from prize
        where id in
        <foreach item="item" collection="items" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="selectById" resultType="com.example.lotterysystem.dao.dataobject.PrizeDO">
        select * from prize where id = #{id}
    </select>
</mapper>